# Copy this file to .env (on your computer) or paste these into your host's
# "Variables" screen. Never share the real values.

# ---------- Your server ----------
# The https address your host gives you, e.g. https://driver-calls.up.railway.app
PUBLIC_URL=
# Make up a long password. You type it once on the phone page.
ADMIN_TOKEN=
# Folder for drivers + call progress. Must be on a persistent volume (e.g. /data on Railway)
DATA_DIR=./data
TIMEZONE=Asia/Kuala_Lumpur
# Said on every call: "Ini panggilan bangun tidur dari ..."
COMPANY_NAME=Pacific Venture Logistics

# ---------- Twilio (same account as your aircooler AI agent is fine) ----------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Twilio number that calls your drivers, in + format, e.g. +12025550123
TWILIO_FROM_NUMBER=
# How long a call rings before it counts as "no answer"
RING_SECONDS=40

# ---------- You (the boss) ----------
# Your mobile. You get a call when a driver doesn't answer, isn't out, or has a problem.
OWNER_PHONE=
# ms = Malay, en = English
OWNER_LANG=ms

# ---------- Optional: AI for spoken answers ----------
# Keypresses (1 / 2 / 3) always work. With a Claude API key, spoken answers like
# "tayar pancit boss" are understood better. Without it, keyword matching is used.
ANTHROPIC_API_KEY=
MODEL=claude-haiku-5-5

# ---------- Rules (defaults shown) ----------
# Wake-up call: tries before calling you, minutes between tries
WAKE_MAX_ATTEMPTS=3
WAKE_RETRY_MINUTES=5
# "Dah keluar?" call: tries if no answer, minutes between tries
OUT_MAX_ATTEMPTS=3
OUT_RETRY_MINUTES=5
# If the driver says "belum": call back after this many minutes...
OUT_RECHECK_MINUTES=10
# ...and call you once they've said "belum" this many times
OUT_MAX_NOT_YET=2
# Calls to you: extra tries if you don't press 1, minutes between tries
OWNER_CALL_RETRIES=2
OWNER_RETRY_MINUTES=3
# If the server was off at call time, still call if it's no later than this
CATCH_UP_MINUTES=30

# ---------- Voices (change only if you know you need to) ----------
VOICE_MS=Google.ms-MY-Standard-A
VOICE_EN=Google.en-US-Standard-C

# Set to true to try everything on your computer without real calls
DRY_RUN=false
